modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_database:1.0.0", "python_log_in_with_replit:1.0.0", "flask_stripe:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Speech Therapy App"

[[workflows.workflow]]
name = "Speech Therapy App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "AUTH_DISABLED=1 python app.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34573
externalPort = 3001

[[ports]]
localPort = 36727
externalPort = 3002

[[ports]]
localPort = 37775
externalPort = 3003

[[ports]]
localPort = 38597
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "-k", "gthread", "-w", "2", "--threads", "8", "-b", "0.0.0.0:5000", "--timeout", "120", "app:app"]
